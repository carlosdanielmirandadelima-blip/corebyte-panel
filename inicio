cat > app/dashboard/page.tsx <<'DASHPAGEOF'
"use client";
import { useEffect, useState } from "react";
import { useSession, signOut } from "next-auth/react";
import { Container } from "@/lib/types";

export default function DashboardPage() {
  const { data: session } = useSession();
  const [containers, setContainers] = useState<Container[]>([]);
  const [loading, setLoading] = useState(true);
  const [selectedContainer, setSelectedContainer] = useState<string | null>(null);
  const [logs, setLogs] = useState<string>("");

  const fetchContainers = async () => {
    const res = await fetch("/api/containers");
    setContainers(await res.json());
    setLoading(false);
  };

  useEffect(() => {
    fetchContainers();
  }, []);

  const handleAction = async (id: string, action: "start" | "stop" | "restart") => {
    await fetch(`/api/containers/${id}`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ action }),
    });
    fetchContainers();
  };

  const viewLogs = async (id: string) => {
    setSelectedContainer(id);
    const res = await fetch(`/api/containers/${id}/logs`);
    const data = await res.json();
    setLogs(data.logs);
  };

  return (
    <div className="p-6">
      <div className="flex justify-between items-center mb-6">
        <div>
          <h1 className="text-2xl font-bold">Bem-vindo, {session?.user?.name}</h1>
          <p className="text-gray-400">Painel de Containers</p>
        </div>
        <button onClick={() => signOut()} className="px-4 py-2 bg-red-600/20 text-red-400 rounded-lg hover:bg-red-600/40">Sair</button>
      </div>

      {loading ? (
        <div className="text-center py-12 text-gray-400">Carregando containers...</div>
      ) : containers.length === 0 ? (
        <div className="border border-dashed border-gray-700 rounded-xl p-12 text-center">
          <h3 className="text-xl text-gray-400 mb-2">Nenhum container encontrado</h3>
          <p className="text-gray-500">Crie containers Docker para vê-los aqui.</p>
        </div>
      ) : (
        <div className="grid gap-4">
          {containers.map((container) => (
            <div key={container.id} className="bg-gray-900/60 border border-gray-700 rounded-lg p-4">
              <div className="flex items-center justify-between">
                <div>
                  <div className="flex items-center gap-2">
                    <span className="text-lg font-semibold">{container.name}</span>
                    <span className={`px-2 py-0.5 text-xs rounded-full ${
                      container.state === "running" ? "bg-green-500/20 text-green-400" :
                      container.state === "exited" ? "bg-red-500/20 text-red-400" :
                      "bg-yellow-500/20 text-yellow-400"
                    }`}>{container.state}</span>
                  </div>
                  <p className="text-sm text-gray-400 mt-1">{container.image}</p>
                </div>
                <div className="flex gap-2">
                  {container.state !== "running" ? (
                    <button onClick={() => handleAction(container.id, "start")} className="px-3 py-1 bg-green-600/20 text-green-400 rounded">Start</button>
                  ) : (
                    <>
                      <button onClick={() => handleAction(container.id, "stop")} className="px-3 py-1 bg-yellow-600/20 text-yellow-400 rounded">Stop</button>
                      <button onClick={() => handleAction(container.id, "restart")} className="px-3 py-1 bg-blue-600/20 text-blue-400 rounded">Restart</button>
                    </>
                  )}
                  <button onClick={() => viewLogs(container.id)} className="px-3 py-1 bg-purple-600/20 text-purple-400 rounded">Logs</button>
                </div>
              </div>
              {selectedContainer === container.id && (
                <div className="mt-4 bg-black/50 rounded p-3 max-h-48 overflow-auto">
                  <pre className="text-xs text-gray-300">{logs || "Sem logs disponíveis"}</pre>
                </div>
              )}
            </div>
          ))}
        </div>
      )}
    </div>
  );
}
DASHPAGEOF

